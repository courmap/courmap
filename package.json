{
  "name": "courmap-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "builder": "tsx --conditions=@courmap/source packages/builder/src/cli.ts",
    "validate": "pnpm run builder validate",
    "compile": "pnpm run builder compile",
    "gen:types": "tsx --conditions=@courmap/source packages/core/scripts/gen-types.ts",
    "check:types-fresh": "pnpm run gen:types --check",
    "check:dashes": "node scripts/check-no-em-dash.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r --filter ./packages/** run build",
    "check": "pnpm check:dashes && pnpm check:types-fresh && pnpm typecheck && pnpm validate && pnpm compile --out out/courmap.sqlite && pnpm builder shards --from out/courmap.sqlite --out out/shards/v1 && pnpm test && pnpm corpus",
    "fixtures:expect": "tsx --conditions=@courmap/source packages/builder/scripts/fixture-expect.ts",
    "seed": "tsx --conditions=@courmap/source packages/seed/src/cli.ts",
    "corpus": "tsx --conditions=@courmap/source packages/client/scripts/corpus.ts",
    "corpus:import": "tsx --conditions=@courmap/source packages/client/scripts/corpus-import.ts",
    "release": "tsx --conditions=@courmap/source packages/release/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
