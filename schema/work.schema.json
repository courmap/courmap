{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/courmap/courmap/main/schema/work.schema.json",
  "title": "WorkFile",
  "description": "One canonical work (usually one cour, film or OVA): data/works/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "episodes"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/slug",
      "description": "Stable slug, equal to the file name. Never changes once published."
    },
    "type": {
      "enum": [
        "tv",
        "movie",
        "ova",
        "ona",
        "special"
      ]
    },
    "status": {
      "enum": [
        "finished",
        "airing",
        "upcoming"
      ],
      "description": "Omitted means finished. Open-ended ranges require airing."
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "episodes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Regular episode count. null only while airing or upcoming."
    },
    "specials": {
      "type": "integer",
      "minimum": 0,
      "description": "Special (S) episode count. Omitted means unknown, which skips the specials bounds check."
    },
    "titles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "romaji": {
          "$ref": "#/$defs/text"
        },
        "english": {
          "$ref": "#/$defs/text"
        },
        "native": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "ids": {
      "title": "WorkIds",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anidb": {
          "$ref": "#/$defs/numericId"
        },
        "anilist": {
          "$ref": "#/$defs/numericId"
        },
        "mal": {
          "$ref": "#/$defs/numericId"
        },
        "kitsu": {
          "$ref": "#/$defs/numericId"
        },
        "tvdb_show": {
          "$ref": "#/$defs/numericId"
        },
        "tmdb_show": {
          "$ref": "#/$defs/numericId"
        },
        "tmdb_movie": {
          "$ref": "#/$defs/numericId"
        },
        "imdb": {
          "type": "string",
          "pattern": "^tt[0-9]{7,}$"
        }
      }
    },
    "projections": {
      "title": "WorkProjections",
      "description": "How season-based providers lay out this work's episodes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tvdb_show": {
          "$ref": "#/$defs/projectionBlock"
        },
        "tmdb_show": {
          "$ref": "#/$defs/projectionBlock"
        }
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "prequel": {
      "$ref": "#/$defs/slug",
      "description": "id of the work this one directly follows."
    },
    "notes": {
      "type": "string"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "description": "Lowercase letters and digits, separated by single hyphens (for example sousou-no-frieren).",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "numericId": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      }
    },
    "episodeRange": {
      "title": "EpisodeRange",
      "description": "A single episode (12, \"S3\") or a range (\"1-12\", \"S1-S2\", \"892-\" for open-ended). Prefix S = special, C = credit, T = trailer, P = parody; no prefix = regular.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^([SCTP]?)[1-9][0-9]*(-(\\1?[1-9][0-9]*)?)?$"
        }
      ]
    },
    "targetRange": {
      "title": "TargetRange",
      "description": "Provider episode numbers for an N-to-M split: a single number or \"12-13\".",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+-[0-9]+$"
        }
      ]
    },
    "projection": {
      "title": "ProjectionEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodes"
      ],
      "properties": {
        "episodes": {
          "$ref": "#/$defs/episodeRange"
        },
        "kind": {
          "enum": [
            "regular",
            "special",
            "credit",
            "trailer",
            "parody"
          ],
          "description": "Defaults to the kind implied by the episodes prefix."
        },
        "season": {
          "type": "integer",
          "minimum": 0,
          "description": "Provider season. Omit for providers or orderings without seasons (for example TVDB absolute order)."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Provider episode number of the first episode in the range. Defaults to the first canonical number."
        },
        "target": {
          "$ref": "#/$defs/targetRange",
          "description": "Only for N-to-M splits: one canonical episode to several provider episodes, or several to one."
        },
        "gap": {
          "type": "boolean",
          "description": "Marks that the canonical episodes just before this range are intentionally unmapped."
        }
      }
    },
    "projectionList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "projectionBlock": {
      "title": "ProjectionBlock",
      "description": "One provider's projection: a list of ranges, or an object when coverage needs a note.",
      "oneOf": [
        {
          "$ref": "#/$defs/projectionList"
        },
        {
          "title": "ProjectionBlockObject",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ranges"
          ],
          "properties": {
            "coverage": {
              "enum": [
                "full",
                "partial"
              ],
              "description": "partial: the ranges intentionally stop before the work's last episode. Requires notes."
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "description": "Why coverage is partial (for example: the provider has not listed the later episodes)."
            },
            "ranges": {
              "$ref": "#/$defs/projectionList"
            }
          }
        }
      ]
    }
  }
}
