{
  "name": "@courmap/parser",
  "version": "0.1.1",
  "description": "Courmap parser: an anime release-name tokenizer (group, title, season, episode, quality, flags)",
  "keywords": [
    "anime",
    "release-name",
    "parser",
    "fansub"
  ],
  "license": "Apache-2.0",
  "homepage": "https://courmap.com/",
  "bugs": {
    "url": "https://github.com/courmap/courmap/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/courmap/courmap.git",
    "directory": "packages/parser"
  },
  "exports": {
    ".": {
      "@courmap/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@courmap/core": "workspace:*"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
