---
// The default Starlight footer, with the attribution TMDB's terms require, on every page.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>
<p class="tmdb-attribution">
  This product uses the TMDB API but is not endorsed or certified by <a href="https://www.themoviedb.org/">TMDB</a>.
</p>

<style>
  .tmdb-attribution {
    margin-top: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: center;
  }
</style>
