{
  "name": "@courmap/proxy",
  "version": "0.0.0",
  "description": "Courmap Sonarr Torznab proxy: rewrites anime release names into the numbering Sonarr understands",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/courmap/courmap.git",
    "directory": "packages/proxy"
  },
  "bin": {
    "courmap-proxy": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@courmap/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@courmap/client": "workspace:*",
    "@courmap/core": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@courmap/builder": "workspace:*",
    "esbuild": "0.28.2"
  }
}
