{
  "name": "@courmap/client",
  "version": "0.1.1",
  "description": "Courmap client: translate anime episodes between AniDB, AniList, MAL, Kitsu, TVDB, TMDB, IMDb and absolute numbering, and resolve release names, offline or remote",
  "keywords": [
    "anime",
    "episode",
    "numbering",
    "anidb",
    "anilist",
    "myanimelist",
    "kitsu",
    "tvdb",
    "tmdb",
    "sonarr",
    "release-name"
  ],
  "license": "Apache-2.0",
  "homepage": "https://courmap.com/",
  "bugs": {
    "url": "https://github.com/courmap/courmap/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/courmap/courmap.git",
    "directory": "packages/client"
  },
  "exports": {
    ".": {
      "@courmap/source": {
        "browser": "./src/browser.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./remote": {
      "@courmap/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@courmap/core": "workspace:*",
    "@courmap/parser": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "@types/better-sqlite3": "^9.6.0"
  },
  "devDependencies": {
    "@courmap/builder": "workspace:*",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/browser.js",
        "default": "./dist/index.js"
      },
      "./remote": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    }
  }
}
